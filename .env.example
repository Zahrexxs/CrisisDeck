NODE_ENV=production
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=tdmrc_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=tdmrc_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# PgAdmin Configuration
PGADMIN_EMAIL=admin@tdmrc.com
PGADMIN_PASSWORD=admin_password

# Map tiles (defaults to OpenStreetMap raster tiles; no API key)
# TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# TILE_MAX_ZOOM=19
# For production, use a provider with a key or a self-hosted tileserver.
